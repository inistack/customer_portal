# Clerk API keys — get these from https://dashboard.clerk.com
# (API Keys page, inside your Clerk application)
#
# Leave both blank for now: the portal runs on local seeded-credential
# login (see rflx_customer_portal/states/auth_state.py) until these are
# provided. Once you have real keys, fill this in, copy this file to
# `.env` (NOT committed — see .gitignore), and follow the "Swapping in
# real Clerk auth" section in setup.md.

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
